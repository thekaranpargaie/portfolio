                      "id": "10dpT",
                      "name": "codeLine2",
                      "fill": "#6B7280",
                      "content": "using Microsoft.AspNetCore.Builder;",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "BzhAC",
                      "name": "codeLine3",
                      "fill": "#6B7280",
                      "content": "using DomainDriven.Architecture;",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "SEe9u",
                      "name": "codeLine4",
                      "fill": "#6B7280",
                      "content": " ",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "F4yXg",
                      "name": "codeLine5",
                      "fill": "#E2E8F0",
                      "content": "var builder = WebApplication.CreateBuilder();",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "JBz2e",
                      "name": "codeLine6",
                      "fill": "#6B7280",
                      "content": " ",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fDg5k",
                      "name": "codeLine7",
                      "fill": "#E2E8F0",
                      "content": "builder.Services",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "3Uxcy",
                      "name": "codeLine8",
                      "fill": "#00D4AA",
                      "content": "  .AddMicroservices()",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Id04b",
                      "name": "codeLine9",
                      "fill": "#00D4AA",
                      "content": "  .AddRabbitMQ()",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "CP6Eh",
                      "name": "codeLine10",
                      "fill": "#00D4AA",
                      "content": "  .AddSignalR()",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Lj1S4",
                      "name": "codeLine11",
                      "fill": "#00D4AA",
                      "content": "  .AddAzureCloud();",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "qc3Y7",
                      "name": "codeLine12",
                      "fill": "#6B7280",
                      "content": " ",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fcPeI",
                      "name": "codeLine13",
                      "fill": "#E2E8F0",
                      "content": "var app = builder.Build();",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Qu7YS",
                      "name": "codeLine14",
                      "fill": "#6C63FF",
                      "content": "app.MapControllers();",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "GQEjO",
                      "name": "codeLine15",
                      "fill": "#6C63FF",
                      "content": "app.UseAzureMonitoring();",
                      "lineHeight": 1.6,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "QUQGz",
